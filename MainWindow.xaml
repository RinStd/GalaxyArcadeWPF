<Window x:Class="GalaxyArcadeWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galaxy Arcade"
        Width="1360" Height="850"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#060A17"
        Foreground="#F3F6FF"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp">
    <Window.Resources>
        <Style x:Key="PanelBorder" TargetType="Border">
            <Setter Property="Background" Value="#0B1226" />
            <Setter Property="BorderBrush" Value="#1B2948" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8290B5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#17213B" BorderThickness="0,0,0,1" Padding="32,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#102A3A" Margin="0,0,14,0">
                        <TextBlock Text="✦" Foreground="#48F2E3" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="GALAXY ARCADE" FontSize="23" FontWeight="Bold" />
                        <TextBlock Text="DEEP SPACE DEFENSE  /  SECTOR 07" FontSize="10" Foreground="#8290B5" Margin="1,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#48F2E3" Margin="0,0,9,0" />
                    <TextBlock x:Name="StateText" Text="READY TO LAUNCH" Foreground="#A8B6D7" FontSize="11" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MISSION" Style="{StaticResource SectionLabel}" Margin="0,0,0,14" />
                        <TextBlock Text="Defend the&#10;galaxy." FontSize="22" FontWeight="SemiBold" LineHeight="29" />
                        <TextBlock Text="Clear incoming enemy waves and protect your ship. Each 150 points advances the sector." Foreground="#8794B3" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,10,0,0" />
                        <Border Height="1" Background="#1B2948" Margin="0,17,0,13" />
                        <TextBlock Text="CURRENT SECTOR" Style="{StaticResource SectionLabel}" />
                        <TextBlock x:Name="MissionWaveText" Text="01" Foreground="#48F2E3" FontSize="34" FontWeight="Light" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <TextBlock Text="FLIGHT CONTROLS" Style="{StaticResource SectionLabel}" Margin="0,0,0,14" />
                        <TextBlock Text="MOVE" Foreground="#F3F6FF" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="W A S D  /  ARROWS" Foreground="#8290B5" FontSize="10" Margin="0,3,0,12" />
                        <TextBlock Text="FIRE" Foreground="#F3F6FF" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="SPACE BAR" Foreground="#8290B5" FontSize="10" Margin="0,3,0,12" />
                        <TextBlock Text="PAUSE" Foreground="#F3F6FF" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="P KEY" Foreground="#8290B5" FontSize="10" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" Background="#070D1C" BorderBrush="#26375B" BorderThickness="1" CornerRadius="14" Padding="7">
                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="GameCanvas" Width="900" Height="600" Background="#070D1C" ClipToBounds="True" />
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="2" Margin="16,0,0,0">
                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="FLIGHT TELEMETRY" Style="{StaticResource SectionLabel}" Margin="0,0,0,16" />
                        <TextBlock Text="SCORE" Foreground="#8290B5" FontSize="10" />
                        <TextBlock x:Name="ScoreText" Text="000000" Foreground="#F3F6FF" FontSize="34" FontWeight="Light" Margin="0,2,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="BEST" Foreground="#8290B5" FontSize="10" />
                                <TextBlock x:Name="BestScoreText" Text="000000" Foreground="#AEB9D5" FontSize="17" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="WAVE" Foreground="#8290B5" FontSize="10" />
                                <TextBlock x:Name="WaveText" Text="01" Foreground="#48F2E3" FontSize="17" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                        <Border Height="1" Background="#1B2948" Margin="0,15,0,12" />
                        <TextBlock Text="SHIELDS" Foreground="#8290B5" FontSize="10" />
                        <TextBlock x:Name="LivesText" Text="03  /  03" Foreground="#FF7198" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MISSION CONTROL" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                        <Button x:Name="StartButton" Content="LAUNCH GAME" Click="StartButton_Click" Background="#123B46" BorderBrush="#1D7D7D" Margin="0,0,0,8" />
                        <Button x:Name="PauseButton" Content="PAUSE" Click="PauseButton_Click" Margin="0,0,0,8" IsEnabled="False" />
                        <Button Content="RESTART MISSION" Click="RestartButton_Click" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelBorder}">
                    <StackPanel>
                        <TextBlock Text="FIELD INTEL" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                        <TextBlock Text="Enemy fire tracks your position. Keep moving to avoid incoming shots." Foreground="#8794B3" FontSize="11" TextWrapping="Wrap" LineHeight="17" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="32,0">
            <TextBlock Text="GALACTIC DEFENSE NETWORK" Foreground="#526080" FontSize="9" VerticalAlignment="Center" />
            <TextBlock Text="ARROW KEYS / WASD  ·  SPACE TO FIRE  ·  P TO PAUSE  ·  R TO RESTART" Foreground="#526080" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>